<resources>

    <!--
        Matrix theme: dark base, phosphor-green accents and text throughout.
        Built on the AppCompat dark parent so system widgets pick up
        light-on-dark defaults automatically.
    -->
    <style name="AppTheme" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/matrixBlack</item>
        <item name="android:colorBackground">@color/matrixBlack</item>
        <item name="preferenceTheme">@style/preferenceTheme</item>

        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textColorPrimary">@color/textPrimary</item>
        <item name="android:textColorSecondary">@color/textSecondary</item>
        <item name="android:textColorTertiary">@color/textDisabled</item>
        <item name="android:textColorHint">@color/matrixGreenDim</item>

        <item name="colorControlNormal">@color/matrixGreenMid</item>
        <item name="colorControlActivated">@color/matrixGreen</item>
        <item name="colorControlHighlight">@color/matrixGreenFaint</item>
        <item name="colorButtonNormal">@color/matrixSurfaceRaised</item>
        <item name="buttonStyle">@style/MatrixButton</item>
        <item name="android:buttonStyle">@style/MatrixButton</item>
        <item name="buttonBarButtonStyle">@style/MatrixButtonSecondary</item>
        <item name="android:buttonBarButtonStyle">@style/MatrixButtonSecondary</item>

        <item name="android:divider">@color/dividerColor</item>
        <item name="alertDialogTheme">@style/MatrixAlertDialog</item>
        <item name="android:alertDialogTheme">@style/MatrixAlertDialog</item>
    </style>

    <!-- Terminal activity: pure black, no chrome competing with the output. -->
    <style name="TerminalTheme" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/matrixBlack</item>
        <item name="colorPrimaryDark">@color/matrixBlack</item>
        <item name="colorAccent">@color/matrixGreen</item>
        <item name="android:windowBackground">@color/matrixBlack</item>
        <item name="android:textColor">@color/matrixGreen</item>
        <item name="android:textColorPrimary">@color/matrixGreen</item>
        <item name="colorControlNormal">@color/matrixGreen</item>
    </style>

    <style name="MatrixAlertDialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="android:background">@color/matrixSurface</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textColorPrimary">@color/textPrimary</item>
        <item name="colorAccent">@color/matrixGreen</item>
    </style>

    <!--
        Buttons. Widget.AppCompat.Button.Colored fills with colorButtonNormal and
        derives the label colour from it; because colorButtonNormal was a
        near-black surface, the label was rendered near-black too (measured
        #131814 on #0D140D, roughly 1.1:1 - invisible). Use an explicit green
        fill with a black label instead.
    -->
    <style name="MatrixButton" parent="Widget.AppCompat.Button.Colored">
        <item name="android:textColor">@color/matrixBlack</item>
        <item name="android:textStyle">bold</item>
        <item name="android:backgroundTint">@color/matrixGreen</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Lower-emphasis action: outlined, green label on the dark surface. -->
    <style name="MatrixButtonSecondary" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">@color/matrixGreen</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="preferenceTheme" parent="PreferenceThemeOverlay">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textColorSecondary">@color/textSecondary</item>
    </style>

</resources>
